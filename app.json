{
  "expo": {
    "name": "Hayo-Wallet",
    "slug": "Hayo-Wallet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Shared-Logo.jpeg",
    "scheme": "hayowallet",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/Shared-Logo.jpeg"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F8F9FF",
        "foregroundImage": "./assets/images/Shared-Logo.jpeg"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#5B4DFF",
          "image": "./assets/images/Shared-Logo.jpeg",
          "imageWidth": 80
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
